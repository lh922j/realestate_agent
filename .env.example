# ── LLM ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── 카카오 (지오코딩 / 지하철 조회) ──────────────────────────────────
KAKAO_API_KEY=...

# ── DB ───────────────────────────────────────────────────────────────
# SQLite (realestate/ 프로젝트 DB를 공유하는 경우)
DATABASE_URL=sqlite:////절대경로/realestate/data/processed/realestate.db
# PostgreSQL 사용 시:
# DATABASE_URL=postgresql://user:password@localhost:5432/realestate

# ── LightGBM 예측 모델 ───────────────────────────────────────────────
MODEL_PATH=/절대경로/realestate/data/models/price_model_trade_lgbm_complex.pkl

# ── ChromaDB 저장 경로 ───────────────────────────────────────────────
CHROMA_PATH=./data/chroma

# ── 로그 레벨 ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
